{
  "name": "@noverna/core-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Noverna Framework - a TypeScript-first framework for FiveM Enhanced.",
  "license": "MIT",
  "homepage": "https://github.com/novernalabs/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novernalabs/core.git"
  },
  "bugs": {
    "url": "https://github.com/novernalabs/core/issues"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=@noverna/core --filter=./packages/*",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "changeset:publish": "pnpm build:packages && changeset publish",
    "server:setup": "node tools/scripts/setup-server.mjs",
    "server:dev": "node tools/scripts/dev-server.mjs",
    "//prepare": "Non-fatal: no git dir in CI tarball installs, and hooks are pointless there.",
    "prepare": "lefthook install || exit 0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@noverna/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@prisma/engines",
      "lefthook",
      "prisma",
      "turbo"
    ]
  }
}
